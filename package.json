{
  "name": "rentaloc",
  "version": "0.1.0",
  "private": true,
  "description": "Build-free rental investment analysis PWA for metropolitan France.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run check:syntax && npm run lint && npm run format:check && npm test",
    "check:fiscal-approval": "node scripts/check-fiscal-approval.cjs",
    "check:container": "sh scripts/check-container.sh",
    "release:check": "npm run check && npm run check:container && npm run test:e2e && npm run check:fiscal-approval",
    "check:syntax": "node --check src/rules.js && node --check src/schema.js && node --check src/domain.js && node --check src/storage.js && node --check src/install.js && node --check src/app.js && node --check sw.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:md",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:html": "html-validate index.html app.html",
    "lint:js": "eslint src sw.js tests",
    "lint:md": "markdownlint-cli2",
    "serve": "python3 -m http.server --bind 127.0.0.1 8000",
    "docker:build": "docker build --tag rentaloc:local .",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up --build --detach",
    "test": "node --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=95 --test-coverage-branches=70 --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "audit:dependencies": "node scripts/audit-dependencies.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "eslint": "9.33.0",
    "html-validate": "10.4.0",
    "jsdom": "30.1.1",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.6.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  },
  "overrides": {
    "markdownlint-cli2": {
      "smol-toml": "1.9.0"
    },
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  }
}
